# Скопируй в .env и заполни. Не выкладывай .env в git!

# Токен от @BotFather
BOT_TOKEN=123456:ABC...

# Владельцы через запятую
OWNERS=@vagdar1,@posutivkusna

# Домен БЕЗ https://
# Бюджет: IP.sslip.io  (пример: 185.123.45.67.sslip.io) — бесплатно, без покупки домена
# Или свой: loyalty.example.ru
DOMAIN=185.123.45.67.sslip.io

# Полный URL Mini App (обычно https://DOMAIN/app/)
WEBAPP_URL=https://185.123.45.67.sslip.io/app/

API_CORS=*
SHEETS_URL=
BACKUP_ENABLED=1
